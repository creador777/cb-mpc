# ---- Fuzzing: NUNCA publicar en un repo publico ----
# Un artefacto de crash es un PoC de vulnerabilidad: subirlo = divulgacion publica
# antes de reportar. Tambien excluimos binarios y corpus (ruido pesado).
fuzz/hit_*
fuzz/crash-*
fuzz/leak-*
fuzz/oom-*
fuzz/timeout-*
fuzz/slow-unit-*
fuzz/sl_*
fuzz/diag_*
fuzz/tdh2diag_*
fuzz/uaf_*
fuzz/*.log
fuzz/.covstate_*
fuzz/.pivotstate_*
fuzz/corpus*/
fuzz/falsos_positivos/
fuzz/fuzz_malicious
fuzz/fuzz_malicious_mp
fuzz/fuzz_schnorr
fuzz/fuzz_tdh2
fuzz/fuzz_pve
fuzz/fuzz_failed_sign
fuzz/fuzzer/
fuzz/smoke_*

# CUALQUIER poc_*/REPORTE-*/*crash* con CUALQUIER extension (no solo el binario
# sin extension). El bug de ayer: "fuzz/poc_refresh_dos" (sin extension) bloqueaba
# el binario pero NO "poc_refresh_dos.cpp" (el codigo fuente) -> se filtro al repo
# publico un PoC de vulnerabilidad + su reporte completo con archivo:linea exacto.
# Regla generica por PREFIJO, no por nombre exacto, para que esto no vuelva a pasar
# con la proxima extension/herramienta que nadie previo.
fuzz/poc_*
fuzz/REPORTE-*
fuzz/*crash-*
fuzz/*CRASH*
fuzz/HALLAZGO*
fuzz/ESTADO-Y-PROXIMOS-PASOS.md
fuzz/*_d2
fuzz/*_diag
fuzz/*_mutant
fuzz/corpus_mut/
fuzz/corpus_d2/
fuzz/corpus_diag/
fuzz/.cuarentena_*

/fuzz/claves_backup/

# ============================================================================
# RAIZ DEL REPO — HUECO REAL, no teorico (verificado 2026-07-29)
#
# Todas las reglas de arriba estan ancladas a "fuzz/". Pero varios artefactos
# aparecen en la RAIZ del repositorio, donde NINGUNA regla los cubria. Estado
# encontrado ese dia en este repo, que es PUBLICO:
#
#     ?? cbmpc_key1.bin      1112 bytes   <- material de clave, sin ignorar
#     ?? cbmpc_key2.bin       852 bytes   <- idem
#     ?? slow-unit-04d8c89b...             <- artefacto de fuzzing, sin ignorar
#
# "fuzz/*.bin" no matchea "/cbmpc_key1.bin". Estaban a un "git add -A" de
# quedar publicados. Se ancla con "/" para que aplique SOLO a la raiz y no
# tape nada dentro de subdirectorios legitimos. Verificado antes de escribir
# esto: no hay ningun *.bin rastreado en el repo.
# ============================================================================
/*.bin
/cbmpc_key*.bin
/slow-unit-*
/crash-*
/hit_*
/sl_*
/uaf_*
/diag_*
/timeout-*
/oom-*
/leak-*

# Respaldos y locks que genera el utillaje local
*.bak-*
fuzz/.swarm_local.tick.lock
